# Copy to .env.local for development. Production requires the Supabase
# settings and OWNER_EMAIL; research/chat also require OPENAI_API_KEY.

# ── Research engine (optional for the template editor) ─────────────
# platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional model overrides (defaults: gpt-5.4 for research, gpt-5.4-mini for chat/vision)
OPENAI_RESEARCH_MODEL=
OPENAI_CHAT_MODEL=
OPENAI_VISION_MODEL=

# ── Site ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Allowed static frontend (backend configuration; omit for a same-origin deployment)
ENGINE_FRONTEND_URL=
# Static frontend build configuration
ENGINE_API_URL=
ENGINE_PAGES_BASE_PATH=/engine

# ── Sign-in + cloud story store (Supabase) ─────────────────────────
# Leave NEXT_PUBLIC_SUPABASE_URL empty to run locally with NO sign-in
# (the studio opens directly; template designs use the local dev file store).
# Once it's set, only emails in OWNER_EMAIL can sign in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# One address, or several separated by commas.
OWNER_EMAIL=you@example.com,friend@example.com

# Supabase sends one-time sign-in links to the owner email.

# ── Scheduled research (Vercel cron, hourly) ───────────────────────
# Any long random string.
CRON_SECRET=

# ── Image sources (optional) ───────────────────────────────────────
# console.apify.com/settings/integrations: powers "Find images on X"
APIFY_TOKEN=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ── Uploads over 8MB (Vercel Blob) ─────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Instagram login for channels (Meta app) ────────────────────────
# Walkthrough at /admin/instagram-setup
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Paid memberships (optional; only if you sell access) ───────────
STRIPE_SECRET_KEY=
GF_STRIPE_PRICE_ID=
# Signs member cookies. Any long random string; set once, never rotate.
UNLOCK_SECRET=
